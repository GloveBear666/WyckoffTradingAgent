# 留空时首次启动自动生成，保存在 Docker 卷 /data/access-token。
# 自定义口令至少 32 字符；不要填写交易所交易 API Key。
WEB_TOKEN=

# 不配置模型也能使用免费量价结构分析。
# 兼容 OpenAI Chat Completions + tool calling 的服务。
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# Ollama 示例（在宿主机先拉取支持 tools 的模型；本地模型使用主机算力）：
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama
